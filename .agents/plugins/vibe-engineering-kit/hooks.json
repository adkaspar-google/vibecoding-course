{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/guard_immutable_verifiers.py"
          }
        ]
      }
    ]
  }
}
